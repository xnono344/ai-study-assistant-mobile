# Required for Google OAuth (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=xxx.apps.googleusercontent.com

# Required for RevenueCat (subscriptions)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx
# Optional in Expo Go. Native store keys cannot be used there.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_xxx

# Required for Sentry (error tracking)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# API base URL. For a physical phone, use this computer's LAN IP.
# Keep the phone and computer on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000
